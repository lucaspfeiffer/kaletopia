---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { allEntries, onThisDay, thisMonth, yearsAgo, formatLongDate } from '../lib/entries';

const entries = await allEntries();
const today = new Date();
const todays = onThisDay(entries, today);
const monthly = thisMonth(entries, today);
const monthName = today.toLocaleString('en-US', { month: 'long' });
---

<Base title="On this day" description="What happened on this day, in other years." compact>
  <div class="wrap">
    <header class="head">
      <h1>On this day</h1>
      <p class="blurb">{formatLongDate(today)}, in other years. Rebuilt each morning.</p>
    </header>
    <hr class="rule-strong" />
    <section class="block">
      <h2 class="section-head">Today</h2>
      {todays.length > 0 ? (
        <div class="grid">{todays.map((e) => <EntryCard entry={e} note={`${yearsAgo(e.data.when!, today)} years ago`} />)}</div>
      ) : (
        <p class="empty">Nothing in the archive for today yet.</p>
      )}
    </section>
    <section class="block">
      <h2 class="section-head">{monthName}, other years</h2>
      {monthly.length > 0 ? (
        <div class="grid">{monthly.map((e) => <EntryCard entry={e} note={`${yearsAgo(e.data.when!, today)} years ago`} />)}</div>
      ) : (
        <p class="empty">Nothing yet for {monthName}.</p>
      )}
    </section>
  </div>
</Base>

<style>
  .head { padding: 1.5rem 0 0.75rem; }
  h1 { font-size: 2rem; }
  .blurb { margin: 0.25rem 0 0; color: var(--ink-2); font-style: italic; }
  .block { padding-top: 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1.5rem 1.25rem; }
  .empty { color: var(--ink-2); margin: 0; }
</style>
