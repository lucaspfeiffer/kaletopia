---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { allEntries } from '../../lib/entries';
const entries = await allEntries();
---
<Base title="All entries" compact>
  <div class="wrap">
    <header class="head">
      <h1>All entries</h1>
      <p class="blurb">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}, newest first.</p>
    </header>
    <hr class="rule-strong" />
    <div class="grid">
      {entries.map((e) => <EntryCard entry={e} />)}
    </div>
  </div>
</Base>
<style>
  .head { padding: 1.5rem 0 0.75rem; }
  h1 { font-size: 2rem; }
  .blurb { margin: 0.25rem 0 0; color: var(--ink-2); font-style: italic; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1.5rem 1.25rem; padding-top: 1.25rem; }
</style>
