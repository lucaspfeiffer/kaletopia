---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allEntries, formatWhen, formatDate, readMinutes, tagLabel } from '../../lib/entries';
import { sectionForKind } from '../../lib/sections';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await allEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = sectionForKind(d.kind);
const minutes = readMinutes(entry);
const byline = d.contributors.length === 1 ? d.contributors[0] : `${d.contributors.slice(0, -1).join(', ')} and ${d.contributors.at(-1)}`;
const related = await Promise.all(
  d.related.map(async (r) => ({ relation: r.relation, target: await getEntry(r.entry) })),
);
---

<Base title={d.title} description={d.summary} compact>
  <article class="wrap entry">
    <header class="head">
      <p class="topline label">
        <a href={withBase(`${section.slug}/`)}>{section.label}</a>
        {d.when && <span>{formatWhen(d.when)}</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="deck">{d.summary}</p>
      <p class="byline">By {byline}</p>
      <p class="dateline label">
        <span>{formatDate(d.published)}</span>
        {d.updated && <span>Updated {formatDate(d.updated)}</span>}
        <span>{minutes} min read</span>
        {d.media.includes('simulation') && <span class="interactive">Interactive</span>}
      </p>
    </header>

    {d.hero && (
      <figure class="hero">
        <img src={d.hero.src.startsWith('http') ? d.hero.src : withBase(d.hero.src)} alt={d.hero.alt} />
        {(d.hero.credit || d.hero.license) && (
          <figcaption class="caption">{d.hero.credit}{d.hero.license && ` · ${d.hero.license}`}</figcaption>
        )}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="tail prose">
      {d.tags.length > 0 && (
        <section>
          <h2 class="label">Tags</h2>
          <ul class="tags">
            {d.tags.map((t) => <li><a href={withBase(`tags/${t}/`)}>{tagLabel(t)}</a></li>)}
          </ul>
        </section>
      )}
      {related.length > 0 && (
        <section>
          <h2 class="label">Related</h2>
          <ul class="plain">
            {related.map(({ relation, target }) => target && (
              <li><span class="rel">{relation}</span> <a href={withBase(`entries/${target.id}/`)}>{target.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      {d.sources.length > 0 && (
        <section>
          <h2 class="label">Sources</h2>
          <ol class="sources">
            {d.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.title}</a> : s.title}
                {s.author && `, ${s.author}`}{s.date && `, ${s.date}`}{s.license && ` (${s.license})`}
              </li>
            ))}
          </ol>
        </section>
      )}
      <p class="caption contributors">Contributors: {d.contributors.join(', ')}.</p>
      <p class="license caption">
        This entry is licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/">{d.license}</a>.
        <a href={`https://github.com/lucaspfeiffer/kaletopia/tree/main/src/content/entries/${entry.id}`}>Edit on GitHub</a>.
      </p>
    </footer>
  </article>
</Base>

<style>
  .entry { padding-top: 2rem; }
  .head { max-width: var(--measure); margin-inline: auto; text-align: center; }
  .topline { margin: 0 0 0.75rem; display: flex; justify-content: center; gap: 0.35rem; }
  .topline a { color: var(--ink); }
  .topline span::before { content: '· '; }
  h1 { font-size: clamp(2rem, 4.5vw, 2.75rem); font-weight: 700; letter-spacing: -0.01em; }
  .deck { font-size: 1.25rem; color: var(--ink-2); margin: 1rem 0 1rem; line-height: 1.4; }
  .byline { font-family: var(--sans); font-size: 0.875rem; font-weight: 600; margin: 0 0 0.3rem; }
  .dateline { margin: 0 0 2rem; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.35rem; font-weight: 500; letter-spacing: 0.04em; }
  .dateline span + span::before { content: '· '; }
  .dateline .interactive { color: var(--accent); font-weight: 700; }
  .hero { max-width: 56rem; margin: 0 auto 2.5rem; }
  .tail { margin-top: 3rem; border-top: 1px solid var(--rule); padding-top: 1.5rem; font-size: 0.95rem; }
  .tail h2 { margin: 1.25rem 0 0.5rem; }
  .plain { list-style: none; padding: 0; }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags a { font-family: var(--sans); font-size: 0.75rem; font-weight: 600; border: 1px solid var(--rule); padding: 0.25rem 0.6rem; border-radius: 2px; }
  .tags a:hover { border-color: var(--ink); text-decoration: none; }
  .contributors { margin-top: 2rem; }
  .rel { color: var(--ink-3); font-style: italic; }
  .sources { padding-left: 1.25rem; color: var(--ink-2); }
  .license { margin-top: 2rem; }
</style>
