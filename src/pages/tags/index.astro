---
import Base from '../../layouts/Base.astro';
import { allEntries, allTags, tagLabel } from '../../lib/entries';
import { withBase } from '../../lib/url';
const tags = allTags(await allEntries());
---
<Base title="Tags" compact>
  <div class="wrap">
    <header class="head"><h1>Tags</h1></header>
    <hr class="rule-strong" />
    <ul class="tags">
      {tags.map(({ tag, count }) => <li><a href={withBase(`tags/${tag}/`)}>{tagLabel(tag)}</a> <span>{count}</span></li>)}
    </ul>
  </div>
</Base>
<style>
  .head { padding: 1.5rem 0 0.75rem; }
  h1 { font-size: 2rem; }
  .tags { list-style: none; padding: 1rem 0 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tags a { font-family: var(--sans); font-size: 0.8125rem; font-weight: 600; border: 1px solid var(--rule); padding: 0.35rem 0.7rem; border-radius: 2px; text-transform: capitalize; }
  .tags span { font-family: var(--sans); font-size: 0.75rem; color: var(--ink-3); }
</style>
