---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { allEntries, onThisDay, thisMonth, yearsAgo } from '../lib/entries';
import { sections } from '../lib/sections';
import { withBase } from '../lib/url';

const entries = await allEntries();
const today = new Date();
const todays = onThisDay(entries, today);
const monthly = thisMonth(entries, today);
const monthName = today.toLocaleString('en-US', { month: 'long' });

const featured = entries.filter((e) => e.data.featured);
const lead = featured[0] ?? entries[0];
const rest = entries.filter((e) => e !== lead);
const second = rest.slice(0, 2);
const row = rest.slice(2, 5);
const latest = rest.slice(5, 11);
---

<Base title="Kaletopia">
  <div class="wrap">
    <div class="front">
      <section class="main">
        {lead ? (
          <div class:list={['top', { 'has-image': !!lead.data.hero }]}>
            <div class="lead-col">
              <EntryCard entry={lead} size="lead" image={false} />
            </div>
            {lead.data.hero && (
              <figure class="lead-image">
                <a href={withBase(`entries/${lead.id}/`)}>
                  <img src={lead.data.hero.src.startsWith('http') ? lead.data.hero.src : withBase(lead.data.hero.src)} alt={lead.data.hero.alt} />
                </a>
                {lead.data.hero.credit && <figcaption class="caption">{lead.data.hero.credit}</figcaption>}
              </figure>
            )}
            <div class="second-col">
              {second.length > 0 ? (
                second.map((e, i) => (
                  <>
                    {i > 0 && <hr class="rule" />}
                    <EntryCard entry={e} image={false} />
                  </>
                ))
              ) : (
                <div class="note">
                  <p class="kicker">About this paper</p>
                  <p>Kaletopia is a curated encyclopedia of history and ideas, read as text, imagery, video, and interactive simulations. It is new, and it grows one entry at a time.</p>
                  <p><a href={withBase('about/')}>Read more</a> or <a href="https://github.com/lucaspfeiffer/kaletopia/blob/main/CONTRIBUTING.md">help write the next entry</a>.</p>
                </div>
              )}
            </div>
          </div>
        ) : (
          <p class="note">Nothing here yet.</p>
        )}

        {row.length > 0 && (
          <>
            <hr class="rule-strong" />
            <div class="row">
              {row.map((e) => <div class="cell"><EntryCard entry={e} /></div>)}
            </div>
          </>
        )}
      </section>

      <aside class="rail">
        <section>
          <h2 class="section-head">On this day</h2>
          {todays.length > 0 ? (
            todays.map((e, i) => (
              <>
                {i > 0 && <hr class="rule" />}
                <EntryCard entry={e} size="small" note={`${yearsAgo(e.data.when!, today)} years ago`} />
              </>
            ))
          ) : (
            <p class="empty">Nothing in the archive for {monthName} {today.getDate()} yet.</p>
          )}
        </section>

        {monthly.length > 0 && (
          <section>
            <h2 class="section-head">{monthName}, other years</h2>
            {monthly.map((e, i) => (
              <>
                {i > 0 && <hr class="rule" />}
                <EntryCard entry={e} size="small" note={`${yearsAgo(e.data.when!, today)} years ago`} />
              </>
            ))}
          </section>
        )}

        {latest.length > 0 ? (
          <section>
            <h2 class="section-head">Latest</h2>
            {latest.map((e, i) => (
              <>
                {i > 0 && <hr class="rule" />}
                <EntryCard entry={e} size="small" />
              </>
            ))}
          </section>
        ) : (
          <section>
            <h2 class="section-head">Sections</h2>
            <ul class="sections">
              {sections.map((s) => (
                <li><a href={withBase(`${s.slug}/`)}><strong>{s.label}</strong> <span>{s.blurb}</span></a></li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 0 1.5rem;
    padding-top: 1.25rem;
  }
  .main { min-width: 0; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 1.25rem; padding-bottom: 1.25rem; }
  .top.has-image { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) minmax(0, 5fr); }
  .lead-col { padding-right: 1.25rem; border-right: 1px solid var(--rule); }
  .lead-image { margin: 0; }
  .second-col { padding-left: 1.25rem; border-left: 1px solid var(--rule); display: flex; flex-direction: column; gap: 1rem; }
  .top.has-image .second-col { padding-left: 1.25rem; }
  .top.has-image .lead-col { border-right: 0; }
  .note { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.45; }
  .note p { margin: 0 0 0.75em; }
  .note a { text-decoration: underline; }
  .row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.25rem; padding: 1.25rem 0; }
  .cell + .cell { border-left: 1px solid var(--rule); padding-left: 1.25rem; }

  .rail { border-left: 1px solid var(--rule); padding-left: 1.5rem; display: flex; flex-direction: column; gap: 1.75rem; }
  .rail section { display: flex; flex-direction: column; gap: 0.75rem; }
  .empty { color: var(--ink-2); font-size: 0.9375rem; margin: 0; }
  .sections { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .sections li { padding: 0.55rem 0; border-bottom: 1px solid var(--rule); font-size: 0.9375rem; }
  .sections li:last-child { border-bottom: 0; }
  .sections span { color: var(--ink-2); }

  @media (max-width: 60rem) {
    .top.has-image { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .top.has-image .lead-image { grid-column: 1 / -1; order: -1; margin-bottom: 1rem; }
  }
  @media (max-width: 48rem) {
    .front { grid-template-columns: 1fr; }
    .top, .top.has-image { grid-template-columns: 1fr; gap: 1.25rem; }
    .lead-col { border-right: 0; padding-right: 0; }
    .second-col { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 1.25rem; }
    .row { grid-template-columns: 1fr; gap: 1.25rem; }
    .cell + .cell { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 1.25rem; }
    .rail { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule-strong); padding-top: 1.25rem; margin-top: 0.5rem; }
  }
</style>
