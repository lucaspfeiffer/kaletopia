---
import type { Entry } from '../lib/entries';
import { formatWhen, readMinutes } from '../lib/entries';
import { withBase } from '../lib/url';

interface Props {
  entry: Entry;
  size?: 'lead' | 'standard' | 'small';
  image?: boolean;
  note?: string;
}
const { entry, size = 'standard', image = true, note } = Astro.props;
const { title, summary, when, media, hero } = entry.data;
const href = withBase(`entries/${entry.id}/`);
const minutes = readMinutes(entry);
const interactive = media.includes('simulation');
const showImage = image && hero && size !== 'small';
---

<article class:list={['card', size]}>
  {showImage && (
    <a href={href} class="hero"><img src={hero.src.startsWith('http') ? hero.src : withBase(hero.src)} alt={hero.alt} loading="lazy" /></a>
  )}
  {note && <p class="kicker note">{note}</p>}
  <h3><a href={href}>{title}</a></h3>
  {size !== 'small' && <p class="summary">{summary}</p>}
  <p class="label meta">
    {interactive && <span class="interactive">Interactive</span>}
    <span>{minutes} min read</span>
    {when && size !== 'small' && <span>{formatWhen(when)}</span>}
  </p>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 0.4rem; }
  h3 { font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
  .summary { margin: 0; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.4; }
  .meta { margin: 0.15rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; font-weight: 500; letter-spacing: 0.04em; }
  .interactive { color: var(--accent); font-weight: 700; }
  .note { margin: 0; color: var(--ink-2); }
  .hero { margin-bottom: 0.35rem; }
  .hero img { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  .lead h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .lead .summary { font-size: 1.0625rem; }
  .small h3 { font-size: 1rem; }
</style>
