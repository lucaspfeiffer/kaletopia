---
import { withBase } from '../lib/url';
import { sections } from '../lib/sections';
---
<footer>
  <div class="wrap">
    <hr class="rule-strong" />
    <div class="cols">
      <a class="name" href={withBase('/')}>Kaletopia</a>
      <nav aria-label="Footer">
        {sections.map((s) => <a href={withBase(`${s.slug}/`)}>{s.label}</a>)}
        <a href={withBase('on-this-day/')}>On this day</a>
        <a href={withBase('about/')}>About</a>
      </nav>
    </div>
    <p>
      Kaletopia is open: the writing is <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>,
      the code is MIT, and both live on <a href="https://github.com/lucaspfeiffer/kaletopia">GitHub</a>.
      Not for profit, ever.
    </p>
  </div>
</footer>
<style>
  footer { margin-top: 4rem; padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px)); font-family: var(--sans); }
  .cols { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 1rem 0 0.5rem; }
  .name { font-family: var(--blackletter); font-size: 1.75rem; }
  nav { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 0.8125rem; font-weight: 600; }
  p { font-size: 0.75rem; color: var(--ink-3); margin: 0.5rem 0 0; }
  p a { text-decoration: underline; }
</style>
